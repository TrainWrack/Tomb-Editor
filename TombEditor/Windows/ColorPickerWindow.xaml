<Window x:Class="TombEditor.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Color Picker" 
        Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Color Preview -->
        <Border Grid.Row="0" 
                Background="#252526" 
                BorderBrush="#555555" 
                BorderThickness="1"
                Height="80"
                Margin="0,0,0,15">
            <Rectangle x:Name="ColorPreview" 
                      Fill="White"
                      Margin="5"/>
        </Border>

        <!-- RGB Sliders and Inputs -->
        <StackPanel Grid.Row="1">
            <!-- Red -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Red:" VerticalAlignment="Center"/>
                <Slider x:Name="RedSlider" 
                       Grid.Column="1" 
                       Minimum="0" 
                       Maximum="255" 
                       Value="255"
                       TickFrequency="1"
                       IsSnapToTickEnabled="True"
                       ValueChanged="RgbSlider_ValueChanged"
                       VerticalAlignment="Center"/>
                <TextBox x:Name="RedTextBox" 
                        Grid.Column="2" 
                        Text="255"
                        TextChanged="RgbTextBox_TextChanged"
                        Width="50"/>
            </Grid>

            <!-- Green -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Green:" VerticalAlignment="Center"/>
                <Slider x:Name="GreenSlider" 
                       Grid.Column="1" 
                       Minimum="0" 
                       Maximum="255" 
                       Value="255"
                       TickFrequency="1"
                       IsSnapToTickEnabled="True"
                       ValueChanged="RgbSlider_ValueChanged"
                       VerticalAlignment="Center"/>
                <TextBox x:Name="GreenTextBox" 
                        Grid.Column="2" 
                        Text="255"
                        TextChanged="RgbTextBox_TextChanged"
                        Width="50"/>
            </Grid>

            <!-- Blue -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Blue:" VerticalAlignment="Center"/>
                <Slider x:Name="BlueSlider" 
                       Grid.Column="1" 
                       Minimum="0" 
                       Maximum="255" 
                       Value="255"
                       TickFrequency="1"
                       IsSnapToTickEnabled="True"
                       ValueChanged="RgbSlider_ValueChanged"
                       VerticalAlignment="Center"/>
                <TextBox x:Name="BlueTextBox" 
                        Grid.Column="2" 
                        Text="255"
                        TextChanged="RgbTextBox_TextChanged"
                        Width="50"/>
            </Grid>
        </StackPanel>

        <!-- Hex Input -->
        <Grid Grid.Row="2" Margin="0,10,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Hex:" VerticalAlignment="Center"/>
            <TextBox x:Name="HexTextBox" 
                    Grid.Column="1" 
                    Text="#FFFFFF"
                    TextChanged="HexTextBox_TextChanged"
                    FontFamily="Consolas"
                    Margin="5,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right">
            <Button x:Name="OKButton" 
                   Content="OK" 
                   Click="OKButton_Click"
                   IsDefault="True"/>
            <Button x:Name="CancelButton" 
                   Content="Cancel" 
                   Click="CancelButton_Click"
                   IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
