<Window x:Class="TombEditor.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
        xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
        mc:Ignorable="d"
        Title="Color Picker" 
        Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush_Background}"
        Style="{DynamicResource CustomWindowStyle}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Grid Margin="{x:Static darkUI:Defaults.MediumThickness}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Color Preview -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Brush_Panel}" 
                BorderBrush="{DynamicResource Brush_Border_Low}" 
                BorderThickness="{x:Static darkUI:Defaults.BorderThickness}"
                Height="80">
            <Border.Margin>
                <Thickness Bottom="{x:Static darkUI:Defaults.MediumThicknessWidth}"/>
            </Border.Margin>
            <Rectangle x:Name="ColorPreview" 
                      Fill="White"
                      Margin="{x:Static darkUI:Defaults.SmallThickness}"/>
        </Border>

        <!-- RGB Sliders and Inputs -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource Brush_Border_Low}" 
                BorderThickness="{x:Static darkUI:Defaults.BorderThickness}">
            <StackPanel Margin="{x:Static darkUI:Defaults.MediumThickness}">
                <!-- Red -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Red:" VerticalAlignment="Center"/>
                    <Slider x:Name="RedSlider" 
                           Grid.Column="1" 
                           Minimum="0" 
                           Maximum="255" 
                           Value="255"
                           TickFrequency="1"
                           IsSnapToTickEnabled="True"
                           ValueChanged="RgbSlider_ValueChanged"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="RedTextBox" 
                            Grid.Column="2" 
                            Text="255"
                            TextChanged="RgbTextBox_TextChanged"
                            Width="50"
                            Margin="5,0,0,0"/>
                </Grid>

                <!-- Green -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Green:" VerticalAlignment="Center"/>
                    <Slider x:Name="GreenSlider" 
                           Grid.Column="1" 
                           Minimum="0" 
                           Maximum="255" 
                           Value="255"
                           TickFrequency="1"
                           IsSnapToTickEnabled="True"
                           ValueChanged="RgbSlider_ValueChanged"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="GreenTextBox" 
                            Grid.Column="2" 
                            Text="255"
                            TextChanged="RgbTextBox_TextChanged"
                            Width="50"
                            Margin="5,0,0,0"/>
                </Grid>

                <!-- Blue -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Blue:" VerticalAlignment="Center"/>
                    <Slider x:Name="BlueSlider" 
                           Grid.Column="1" 
                           Minimum="0" 
                           Maximum="255" 
                           Value="255"
                           TickFrequency="1"
                           IsSnapToTickEnabled="True"
                           ValueChanged="RgbSlider_ValueChanged"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="BlueTextBox" 
                            Grid.Column="2" 
                            Text="255"
                            TextChanged="RgbTextBox_TextChanged"
                            Width="50"
                            Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Hex Input -->
        <Grid Grid.Row="2">
            <Grid.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.MediumThicknessWidth}" Bottom="{x:Static darkUI:Defaults.MediumThicknessWidth}"/>
            </Grid.Margin>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Hex:" VerticalAlignment="Center"/>
            <TextBox x:Name="HexTextBox" 
                    Grid.Column="1" 
                    Text="#FFFFFF"
                    TextChanged="HexTextBox_TextChanged"
                    FontFamily="Consolas"
                    Margin="5,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <controls:SpacedStack Grid.Row="3" 
                              HorizontalAlignment="Right"
                              Orientation="Horizontal"
                              Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <Button x:Name="OKButton" 
                   Content="OK" 
                   Click="OKButton_Click"
                   Width="80"
                   IsDefault="True"/>
            <Button x:Name="CancelButton" 
                   Content="Cancel" 
                   Click="CancelButton_Click"
                   Width="80"
                   IsCancel="True"/>
        </controls:SpacedStack>
    </Grid>
</Window>
