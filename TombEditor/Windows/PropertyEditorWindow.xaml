<Window x:Class="TombEditor.Windows.PropertyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:darkUI="clr-namespace:DarkUI.WPF;assembly=DarkUI.WPF"
        xmlns:controls="clr-namespace:DarkUI.WPF.CustomControls;assembly=DarkUI.WPF"
        mc:Ignorable="d"
        Title="Property Editor" 
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush_Background}"
        Style="{DynamicResource CustomWindowStyle}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Style for property name labels -->
        <Style x:Key="PropertyNameLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Foreground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Style for property rows -->
        <Style x:Key="PropertyRowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border_Low}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="{x:Static darkUI:Defaults.MediumThickness}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" 
                      Text="Object Properties" 
                      Foreground="{DynamicResource Brush_Foreground}" 
                      FontSize="14" 
                      FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText" 
                      Text="Configure object settings" 
                      Foreground="{DynamicResource Brush_Foreground_Weak}" 
                      FontSize="11" 
                      Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Properties Grid -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource Brush_Border_Low}" 
                BorderThickness="{x:Static darkUI:Defaults.BorderThickness}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PropertiesPanel" Margin="{x:Static darkUI:Defaults.SmallThickness}">
                    <!-- Dynamic property grid rows will be added here -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Description Panel -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Brush_Border_Low}"
                BorderThickness="{x:Static darkUI:Defaults.BorderThickness}"
                Background="{DynamicResource Brush_Background}"
                Margin="0,10,0,0"
                MaxHeight="100">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DescriptionText"
                          Text="Select a property to see its description"
                          Foreground="{DynamicResource Brush_Foreground_Weak}"
                          FontSize="11"
                          FontStyle="Italic"
                          TextWrapping="Wrap"
                          Margin="{x:Static darkUI:Defaults.SmallThickness}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <controls:SpacedStack Grid.Row="3"
                              HorizontalAlignment="Right"
                              Orientation="Horizontal"
                              Spacing="{x:Static darkUI:Defaults.MediumThicknessWidth}">
            <StackPanel.Margin>
                <Thickness Top="{x:Static darkUI:Defaults.MediumThicknessWidth}" />
            </StackPanel.Margin>
            
            <Button x:Name="ResetButton" 
                   Content="Reset to Default" 
                   Click="ResetButton_Click"
                   Width="120"/>
            <Button x:Name="OKButton" 
                   Content="OK" 
                   Click="OKButton_Click"
                   Width="80"
                   IsDefault="True"/>
            <Button x:Name="CancelButton" 
                   Content="Cancel" 
                   Click="CancelButton_Click"
                   Width="80"
                   IsCancel="True"/>
        </controls:SpacedStack>
    </Grid>
</Window>
