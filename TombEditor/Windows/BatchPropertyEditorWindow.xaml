<Window x:Class="TombEditor.Windows.BatchPropertyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Batch Property Editor" 
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D30"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Margin" Value="5,0,10,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <!-- Style for property name labels -->
        <Style x:Key="PropertyNameLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="10">
            <StackPanel>
                <TextBlock x:Name="TitleText" 
                          Text="Batch Property Editor" 
                          Foreground="#F1F1F1" 
                          FontSize="14" 
                          FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleText" 
                          Text="Edit properties for multiple objects" 
                          Foreground="#AAAAAA" 
                          FontSize="11" 
                          Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Properties Panel -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     Margin="10">
            <StackPanel x:Name="PropertiesPanel">
                <!-- Dynamic properties will be added here -->
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#252526" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton" 
                       Content="Reset All to Default" 
                       Click="ResetButton_Click"
                       Width="140"/>
                <Button x:Name="OKButton" 
                       Content="OK" 
                       Click="OKButton_Click"
                       IsDefault="True"/>
                <Button x:Name="CancelButton" 
                       Content="Cancel" 
                       Click="CancelButton_Click"
                       IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
